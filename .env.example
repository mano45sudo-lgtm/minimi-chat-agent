# Set at least ONE provider key. Every provider whose key is set shows up in the model
# picker in the UI. Each uses its own vendor's built-in web search, so no separate search
# key is needed.

# Anthropic (Claude + server-side web search): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (Responses API + hosted web_search tool): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (Google Search grounding): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (GPT-OSS + built-in browser_search, very fast): https://console.groq.com/keys
GROQ_API_KEY=

# Optional (defaults shown)
# PROVIDER=anthropic              # default provider; otherwise the first one with a key
# CHAT_EFFORT=medium              # low | medium | high - lower is faster, higher researches deeper
# MAX_SEARCHES_PER_TURN=8         # Anthropic only (the others have no per-request cap)
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5
# ANTHROPIC_MEMORY_MODEL=claude-haiku-5-5
# OPENAI_CHAT_MODEL=gpt-5
# OPENAI_MEMORY_MODEL=gpt-5-mini
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_MEMORY_MODEL=gemini-3.8-flash
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_MEMORY_MODEL=openai/gpt-oss-20b
# PORT=3000
# DB_PATH=data/minimi.db

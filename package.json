{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A chat agent with web search and dated, verifiable memory.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.1.0",
    "chrono-node": "^2.10.3",
    "dompurify": "^3.4.17",
    "groq-sdk": "^1.6.0",
    "marked": "^18.2.0",
    "openai": "^7.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
